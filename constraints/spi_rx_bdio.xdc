# 과제10 수신: PORT A (BDIO) 사용. I/O 00=SCK(F8), I/O 01=MOSI(E8), I/O 02=CS(A7)
set_property PACKAGE_PIN B6 [get_ports clk_50mhz]
set_property PACKAGE_PIN N4 [get_ports rst_p]
set_property PACKAGE_PIN F8 [get_ports spi_sck]
set_property PACKAGE_PIN E8 [get_ports spi_mosi]
set_property PACKAGE_PIN A7 [get_ports spi_cs_n]
set_property PACKAGE_PIN F6 [get_ports pc_txd]
# CLED D1..D8 (핀맵: D1 L4, D2 M4, D3 M2, D4 N7, D5 M7, D6 M3, D7 M1, D8 N5)
set_property PACKAGE_PIN L4 [get_ports {led[0]}]
set_property PACKAGE_PIN M4 [get_ports {led[1]}]
set_property PACKAGE_PIN M2 [get_ports {led[2]}]
set_property PACKAGE_PIN N7 [get_ports {led[3]}]
set_property PACKAGE_PIN M7 [get_ports {led[4]}]
set_property PACKAGE_PIN M3 [get_ports {led[5]}]
set_property PACKAGE_PIN M1 [get_ports {led[6]}]
set_property PACKAGE_PIN N5 [get_ports {led[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports *]
create_clock -name clk_50mhz -period 20.000 [get_ports clk_50mhz]
set_false_path -from [get_ports {rst_p spi_sck spi_mosi spi_cs_n}]
